<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow -->
    <item>
        <shape>
            <solid android:color="#33000000" /> <!-- Semi-transparent shadow -->
            <corners android:radius="8dp" /> <!-- Matches background radius -->
        </shape>
    </item>

    <!-- Background with rounded corners and border -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <solid android:color="#FFFFFF" /> <!-- Background color -->
            <corners android:radius="8dp" /> <!-- Rounded corners -->
            <stroke
                android:width="1dp"
                android:color="#DDDDDD" /> <!-- Border -->
        </shape>
    </item>
</layer-list>
