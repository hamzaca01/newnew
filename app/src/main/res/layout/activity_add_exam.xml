<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".AddExamActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieAddExam"
            android:layout_width="200dp"
            android:layout_height="200dp"
            app:lottie_rawRes="@raw/exam"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

        <EditText
            android:id="@+id/editTextExamName"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Exam Name"
            android:drawableLeft="@drawable/text_icon"
            android:drawablePadding="8dp"
            android:background="@drawable/edittext_bkg"
            android:padding="10dp" />

        <EditText
            android:id="@+id/editTextExamDate"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Select Exam Date"
            android:drawableLeft="@drawable/date_exam"
            android:drawablePadding="8dp"
            android:background="@drawable/edittext_bkg"
            android:padding="10dp"
            android:focusable="false"
            android:clickable="true" />


        <EditText
            android:id="@+id/editTextExamLocation"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Exam Location"
            android:drawableLeft="@drawable/location"
            android:drawablePadding="8dp"
            android:background="@drawable/edittext_bkg"
            android:padding="10dp" />

        <Button
            android:id="@+id/buttonSaveExam"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#E80C0C"
            android:text="Save Exam"
            android:textColor="@android:color/white"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
