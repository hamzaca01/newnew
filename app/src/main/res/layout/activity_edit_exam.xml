<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".EditExamActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Screen Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Exam"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:textColor="#E80C0C" />

        <!-- Lottie Animation -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieEditExam"
            android:layout_width="200dp"
            android:layout_height="200dp"
            app:lottie_rawRes="@raw/exam"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            android:layout_marginBottom="16dp" />

        <!-- Exam Name -->
        <EditText
            android:id="@+id/editTextExamName"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Exam Name"
            android:drawableLeft="@drawable/text_icon"
            android:drawablePadding="8dp"
            android:background="@drawable/edittext_bkg"
            android:padding="10dp"
            android:layout_marginTop="8dp" />

        <!-- Exam Date -->
        <EditText
            android:id="@+id/editTextExamDate"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Exam Date"
            android:drawableLeft="@drawable/date_exam"
            android:drawablePadding="8dp"
            android:background="@drawable/edittext_bkg"
            android:padding="10dp"
            android:layout_marginTop="8dp"
            android:focusable="false"
            android:clickable="true" />

        <!-- Exam Location -->
        <EditText
            android:id="@+id/editTextExamLocation"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Exam Location"
            android:drawableLeft="@drawable/location"
            android:drawablePadding="8dp"
            android:background="@drawable/edittext_bkg"
            android:padding="10dp"
            android:layout_marginTop="8dp" />

        <!-- Update Button -->
        <Button
            android:id="@+id/buttonUpdateExam"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#4CAF50"
            android:text="Update Exam"
            android:textColor="@android:color/white"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
