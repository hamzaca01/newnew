<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="@color/white">

    <!-- Title -->
    <TextView
        android:id="@+id/examTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Exam Management"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Create Exam Button -->
    <Button
        android:id="@+id/buttonCreateExam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#E80C0C"
        android:text="Create Exam"
        android:textColor="@android:color/white"
        android:textSize="18sp" />

    <!-- Search Exams Button -->
    <Button
        android:id="@+id/buttonSearchExam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#E80C0C"
        android:text="Search Exams"
        android:textColor="@android:color/white"
        android:textSize="18sp" />

    <!-- Open Camera Button -->
    <Button
        android:id="@+id/buttonOpenCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#E80C0C"
        android:text="Open Camera"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:layout_marginTop="16dp" />

</LinearLayout>
