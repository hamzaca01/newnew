<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/selectableItemBackground"> <!-- Adds a ripple effect on click -->

    <!-- Exam Name -->
    <TextView
        android:id="@+id/textViewExamName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Exam Name"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black" />

    <!-- Exam Date -->
    <TextView
        android:id="@+id/textViewExamDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Exam Date"
        android:textSize="16sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginTop="4dp" />

    <!-- Exam Location -->
    <TextView
        android:id="@+id/textViewExamLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Exam Location"
        android:textSize="16sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginTop="4dp" />
</LinearLayout>
